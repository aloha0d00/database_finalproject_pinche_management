[Unit]
Description=Carpool API Service
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/carpool_api
Environment="PATH=/opt/carpool_api/venv/bin"
ExecStart=/opt/carpool_api/venv/bin/gunicorn -w 4 -b 0.0.0.0:3000 main:app
Restart=on-failure

[Install]
WantedBy=multi-user.target